# ============== LLM 后端选择 ==============
# 可选: 'koboldcpp', 'ollama', 'openai'
LLM_BACKEND=koboldcpp

# ============== 本地模型配置 ==============
# KoboldCpp
KOBOLDCPP_URL=http://localhost:5001
KOBOLDCPP_MODEL=local-model

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ============== OpenAI API 配置（备选） ==============
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# ============== 采样参数 ==============
TEMPERATURE=1.1
MIN_P=0.05
TOP_P=1.0
TOP_K=0
REPETITION_PENALTY=1.08
MAX_LENGTH=4096

# ============== 提示词配置 ==============
# 是否启用角色扮演模式（虚构剧情框架）
RP_MODE=true

# ============== 其他 ==============
FLASK_ENV=development
DEBUG=false
MAX_CONTEXT_HISTORY=20
